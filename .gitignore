# Rust build output
target/

# Real footage benchmark sets (docs/PLAN.md §8.3). Whole services with all cameras —
# gigabytes, and not ours to publish. Lives on Richard's machine/NAS; the frozen
# truth.json per set is the only thing worth version-controlling, and it travels with
# the corpus rather than with the repo.
corpus/

# Analysis-PCM cache, if ever pointed inside the repo during development.
*.f32

# ffmpeg sidecar binaries (fetched per-platform from Phase 7, never committed)
app/src-tauri/binaries/

# Node / Tauri (from Phase 7).
#
# No trailing slash, and that is the whole point. `node_modules/` matches a DIRECTORY
# only, so the self-referential SYMLINK at `app/node_modules` that rode along in #68 was
# never covered by these rules — git saw a file, not a directory, and happily staged it.
# Untracking it (this commit) fixes today; dropping the slash is what stops the same
# `git add -A` from re-committing it tomorrow.
node_modules
dist/

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
.claude/

# Frontend build output and deps (app/)
app/node_modules
app/dist/
app/src-tauri/target/

# D-093 native-smoke artefacts (report JSON, app log, screenshot). Produced per run.
native-smoke/
