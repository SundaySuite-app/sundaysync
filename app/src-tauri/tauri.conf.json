{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SundaySync",
  "version": "0.6.0-beta.2",
  "identifier": "app.sundaysuite.sundaysync",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SundaySync",
        "hiddenTitle": true,
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; media-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "externalBin": [
      "binaries/ffmpeg",
      "binaries/ffprobe"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "copyright": "Richard Fossland",
    "category": "Video",
    "shortDescription": "Multicamera audio sync for church and event shoots",
    "longDescription": "Drop in everything from a multicamera shoot and get a synchronized timeline as FCPXML for DaVinci Resolve. Free, local, no timecode required."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDZERTFFQTUwOUU0MUM0MkMKUldRc3hFR2VVT3JoYlRvZndLeFRjbGswaC8xWlpjWVNEYXNYZ1ZvL2RxNCtRWUE1ZkZuVmJaNzUK",
      "endpoints": [
        "https://updates.sundaysuite.app/v1/update/sundaysync/stable"
      ]
    }
  }
}
