{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // TS 7: types → [] og noUncheckedSideEffectImports er standard; vite/client
    // deklarerer `*.css`, som main.tsx importerer for sideeffekten. Se docs/DECISIONS.md D-101.
    "types": ["vite/client"]
  },
  "include": ["src"]
}
